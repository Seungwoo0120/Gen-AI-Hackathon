# Copy to .env and fill in. Never commit .env.

# Backend (read by services/api from this root .env)
DATABASE_URL=sqlite:///./dev.db
# mock = all external sources use fake data (works offline); live = real APIs
DATA_SOURCE=mock
# JSON list of frontend origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000"]
# Chat extraction LLM (used only when DATA_SOURCE=live): anthropic or openai
LLM_PROVIDER=anthropic
# API key for LLM_PROVIDER
LLM_API_KEY=
# Empty = provider default (anthropic: claude-opus-5-5, openai: gpt-6-luna)
LLM_MODEL=

# Frontend: Next.js only reads env files in apps/web, so put these in
# apps/web/.env.local. NEXT_PUBLIC_* values are exposed to the browser: no secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
